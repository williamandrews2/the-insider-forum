<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login — The Insider Forum</title>
    <style>
      body {
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
          "Helvetica Neue", Arial;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
      }
      .card {
        width: 100%;
        max-width: 420px;
        background: #fff;
        border-radius: 10px;
        padding: 32px;
        box-shadow: 0 8px 30px rgba(17, 24, 39, 0.12);
      }
      h2 {
        margin-bottom: 8px;
        color: #222;
      }
      p.lead {
        margin-bottom: 20px;
        color: #555;
      }
      label {
        display: block;
        font-size: 0.9rem;
        margin-bottom: 6px;
        color: #444;
      }
      input[type="text"],
      input[type="password"] {
        width: 100%;
        padding: 10px 12px;
        margin-bottom: 16px;
        border: 1px solid #dbe3f0;
        border-radius: 6px;
        font-size: 1rem;
      }
      .actions {
        display: flex;
        gap: 12px;
        align-items: center;
      }
      button {
        background: linear-gradient(90deg, #667eea, #764ba2);
        color: #fff;
        border: none;
        padding: 10px 18px;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
      }
      .secondary {
        background: transparent;
        color: #667eea;
        border: 1px solid transparent;
        text-decoration: underline;
        padding: 8px 0;
      }
      .muted {
        color: #666;
        font-size: 0.95rem;
      }
      .links {
        margin-top: 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      a {
        color: #667eea;
        text-decoration: none;
      }
    </style>
  </head>
  <body>
    <main class="card">
      <h2>Welcome back</h2>
      <p class="lead">Sign in to continue to The Insider Forum.</p>

      <form action="/login" method="POST">
        <label for="email">Username</label>
        <input
          id="username"
          name="username"
          type="text"
          required
          autocomplete="username"
          placeholder="johndoe123"
        />

        <label for="password">Password</label>
        <input
          id="password"
          name="password"
          type="password"
          required
          autocomplete="current-password"
          placeholder="••••••••"
        />

        <div class="actions">
          <button type="submit">Login</button>
          <a class="secondary" href="/">Home</a>
        </div>
      </form>

      <div class="links">
        <p class="muted">
          Don’t have an account? <a href="/signup">Sign up</a>
        </p>
        <a href="/forgot">Forgot password?</a>
      </div>
    </main>
  </body>
</html>
