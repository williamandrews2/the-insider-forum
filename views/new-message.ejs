<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Sign Up</title>
    <style>
      :root{--bg:#f7fafc;--card:#ffffff;--accent:#6366f1;--muted:#64748b}
      *{box-sizing:border-box}
      body{
        margin:0;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;
        background: linear-gradient(180deg, #eef2ff 0%, #f8fafc 100%);
        min-height:100vh;
        display:flex;
        align-items:center;
        justify-content:center;
        padding:24px;
        color:#0f172a
      }
      .card{
        width:100%;
        max-width:640px;
        background:var(--card);
        border-radius:12px;
        padding:28px;
        box-shadow:0 10px 30px rgba(2,6,23,0.08);
      }
      h1{margin:0 0 8px 0;font-size:1.6rem}
      .lead{color:var(--muted);margin-bottom:18px}
      .errors{background:#fff6f6;border:1px solid #fed7d7;color:#7f1d1d;padding:12px;border-radius:8px;margin-bottom:16px}
      form{display:flex;flex-direction: column;}
      label{display:block;font-size:0.9rem;color:#334155;margin-bottom:6px}
      input[type="text"],input[type="password"], textarea{
        width:100%;padding:10px 12px;border:1px solid #e2e8f0;border-radius:8px;font-size:1rem
      }
      .full{grid-column:1 / -1}
      .actions{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-top:12px}
      button{
        background:linear-gradient(90deg,var(--accent),#7c3aed);
        color:white;border:none;padding:10px 16px;border-radius:8px;font-weight:600;cursor:pointer
      }
      .muted{color:var(--muted);font-size:0.95rem}
      @media (max-width:560px){
        form{grid-template-columns:1fr}
        .actions{flex-direction:column;align-items:stretch}
      }
    </style>
  </head>
  <body>
    <div class="card">
      <h1>Create a new message</h1>     

      <!-- render the errors -->
      <% if (locals.errors && errors.length > 0) { %>
        <div class="errors">
          <ul>
            <% errors.forEach(error => { %>
              <li><%= error %></li>
            <% }) %>
          </ul>
        </div>
      <% } %>

      <!-- create message form -->
      <form action="/new" method="POST">
        <div>
          <label for="title">Title</label>
          <input id="title" name="title" type="text" value="<%= locals.title || '' %>" required />
        </div>

        <div>
          <label for="text">Message text</label>
          <textarea id="text" name="text" type="text" value="<%= locals.text || '' %>" required></textarea>
        </div>
         <button type="submit">Post</button>
      </form>
    </div>
  </body>
</html>
