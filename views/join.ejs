<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Join The Club — The Insider Forum</title>
  <style>
    :root{--bg:#f1f5f9;--card:#ffffff;--accent:#6366f1;--muted:#64748b}
    *{box-sizing:border-box}
    body{margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial;background:linear-gradient(180deg,#eef2ff 0%,#f8fafc 100%);min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px;color:#0f172a}
    .card{width:100%;max-width:520px;background:var(--card);padding:28px;border-radius:12px;box-shadow:0 10px 30px rgba(2,6,23,0.07)}
    h1{margin:0 0 6px;font-size:1.4rem}
    p.lead{margin:0 0 16px;color:var(--muted)}
    .errors{background:#fff6f6;border:1px solid #fed7d7;color:#7f1d1d;padding:10px;border-radius:8px;margin-bottom:12px}
    form{display:grid;gap:12px}
    label{display:block;font-size:0.9rem;color:#334155;margin-bottom:6px}
    input[type='text']{width:100%;padding:10px 12px;border:1px solid #e2e8f0;border-radius:8px;font-size:1rem}
    .actions{display:flex;gap:12px;align-items:center;justify-content:space-between;margin-top:6px}
    button{background:linear-gradient(90deg,var(--accent),#7c3aed);color:#fff;border:none;padding:10px 14px;border-radius:8px;font-weight:600;cursor:pointer}
    a{color:var(--accent);text-decoration:none}
    .muted{color:var(--muted)}
    @media (max-width:520px){.actions{flex-direction:column-reverse;align-items:stretch}}
  </style>
</head>
<body>
  <main class="card">
    <h1>Join the Club</h1>
    <p class="lead">Enter your join code to activate membership and access member features.</p>

    <% if (locals.error) { %>
      <div class="errors"><%= error %></div>
    <% } %>

    <% if (locals.success) { %>
      <div style="background:#ecfdf5;border:1px solid #bbf7d0;color:#065f46;padding:10px;border-radius:8px;margin-bottom:12px"><%= success %></div>
    <% } %>

    <form action="/join" method="POST">
      <div>
        <label for="joinCode">Join Code</label>
        <input id="joinCode" name="code" type="text" placeholder="Enter your code" required autocomplete="off" />
      </div>

      <div class="actions">
        <a href="/" class="muted">Back to Home</a>
        <button type="submit">Join</button>
      </div>
    </form>
  </main>
</body>
</html>
