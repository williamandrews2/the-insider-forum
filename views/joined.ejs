<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>You have joined the club!</title>
    <style>
      body {
        margin: 0;
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
          "Helvetica Neue", Arial;
        background: linear-gradient(135deg, #eef2ff 0%, #e6fffa 100%);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        color: #0f172a;
      }
      .panel {
        background: white;
        padding: 36px 28px;
        border-radius: 12px;
        box-shadow: 0 8px 30px rgba(2, 6, 23, 0.08);
        max-width: 720px;
        text-align: center;
      }
      h1 {
        font-size: 1.6rem;
        margin-bottom: 8px;
      }
      p {
        color: #334155;
        margin-bottom: 18px;
        font-size: 1rem;
      }
      a {
        color: #6366f1;
        text-decoration: none;
        font-weight: 600;
      }
    </style>
  </head>
  <body>
    <main class="panel">
      <h1>You have joined the club!</h1>
      <p>Now you are a part of the full experience.</p>
      <p><a href="/messages">Let's go</a></p>
    </main>
  </body>
</html>
